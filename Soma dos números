<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Soma</title>
</head>
<body>
    <script>
    let numero;
    let soma = 0;

    while (numero !== 0)
    {
        numero = prompt("Digite um número (ou 0 para parar):");
        numero = parseInt(numero);
        soma += numero;
    }  
    console.log(soma); 
    </script>
</body>
</html>
